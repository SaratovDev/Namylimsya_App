# ─── Postgres ─────────────────────────────────────────────────────────────
# ВНИМАНИЕ: поменяйте пароль на сильный (openssl rand -hex 32).
POSTGRES_USER=namylimsya
POSTGRES_PASSWORD=strong_32_random_chars_pass
POSTGRES_DB=namylimsya

# ─── JWT ──────────────────────────────────────────────────────────────────
# 32+ символов, ОБЯЗАТЕЛЬНО разные.
# Сгенерировать: openssl rand -hex 32
JWT_ACCESS_SECRET=strong_32_random_chars_pass
JWT_REFRESH_SECRET=strong_32_random_chars_pass_different
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ─── Публичный URL ────────────────────────────────────────────────────────
# Для локальной проверки «как в проде» — http://localhost (без порта,
# т.к. Caddy слушает 80). В реальном проде — https://namylimsya.ru
PUBLIC_BASE_URL=http://localhost
STORAGE_PUBLIC_BASE_URL=http://localhost

# Домен для Caddy (Caddyfile использует {$DOMAIN:localhost}).
# При публичном запуске: DOMAIN=namylimsya.ru и уберите local_certs в Caddyfile.
# DOMAIN=localhost

# Уровень логирования API: debug|info|warn|error (в проде по умолчанию info).
# LOG_LEVEL=info

# ─── SMTP ─────────────────────────────────────────────────────────────────
# В локальной проверке используем mailpit (SMTP на :1025, UI на :8025).
# В реальном проде — SMTP_ENABLED=true с реальными SMTP_HOST/PORT/USER/PASS.
SMTP_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@namylimsya.local

# EMAIL_VERIFICATION_ENABLED=false

# ─── Yandex Maps ──────────────────────────────────────────────────────────
# https://developer.tech.yandex.ru/services
# Оставьте пустым — EventMap покажет фолбэк-блок вместо карты.
# YANDEX_MAPS_API_KEY=