# ─── Окружение ────────────────────────────────────────────────────────────
# development | production
# Обязательно: config.Load() падает, если не задано.
# production включает: JWT-валидацию, HTTPS-требование PUBLIC_BASE_URL,
# маскировку err.Error() в 500, warn про SMTP.
APP_ENV=development
HTTP_PORT=8080

# Уровень логирования zerolog: debug|info|warn|error.
# Дефолт: debug в development, info в production (чтобы SQL-трейсер и
# debug-строки не попадали в прод-логи).
# LOG_LEVEL=info

# Публичный URL фронтенда (для CORS и WS CheckOrigin).
# В production обязателен https://
PUBLIC_BASE_URL=http://localhost:3000

# Доверять ли X-Forwarded-For / X-Real-IP. true — когда API стоит за
# reverse-proxy (Caddy, nginx) и peer — private IP (Docker bridge).
# false (default) — API напрямую, XFF игнорируется. Не ставьте true,
# если порт API проброшен наружу — спуфинг XFF обойдёт rate-limit.
TRUSTED_PROXY=false

# ─── PostgreSQL (с PostGIS) ───────────────────────────────────────────────
# Пример: postgres://user:password@localhost:5432/namylimsya?sslmode=disable
# ВАЖНО: пароль должен совпадать с POSTGRES_PASSWORD в infra/docker-compose.yml
DATABASE_URL=postgres://namylimsya:devpass@localhost:5432/namylimsya?sslmode=disable

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ──────────────────────────────────────────────────────────────────
# В production: минимум 32 символа, access и refresh — РАЗНЫЕ.
# Сгенерировать: openssl rand -hex 32
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ─── SMTP (опционально) ───────────────────────────────────────────────────
# SMTP_ENABLED управляет отправкой писем ВООБЩЕ (дайджест уведомлений,
# ответы поддержки). false → mailer полностью отключён.
# В production настоятельно рекомендуется true (warn, если false).
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@namylimsya.local
# Обязательная верификация email при регистрации (flow пока не реализован).
# EMAIL_VERIFICATION_ENABLED=false

# ─── Storage ──────────────────────────────────────────────────────────────
# local | s3 (s3 пока не реализован)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# Публичный базовый URL бэкенда для /static/* (аватары).
# В проде: https://api.namylimsya.ru
STORAGE_PUBLIC_BASE_URL=http://localhost:8080

# ─── Yandex Maps ──────────────────────────────────────────────────────────
# https://developer.tech.yandex.ru/services
# YANDEX_MAPS_API_KEY=