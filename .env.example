# ===== API =====
APP_ENV=development
HTTP_PORT=8080
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ===== Postgres =====
DATABASE_URL=postgres://namylimsya:devpass@localhost:5432/namylimsya?sslmode=disable

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Email (dev — Mailpit) =====
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@namylimsya.local
EMAIL_VERIFICATION_ENABLED=false

# ===== Storage (dev — local, prod — s3) =====
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ===== Яндекс.Карты (получить заранее) =====
YANDEX_MAPS_API_KEY=

# ===== VK ID (получить заранее) =====
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://localhost:8080/api/v1/auth/vk/callback

# ===== Web (Next.js) =====
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
